{
    "name": "dev/3dmodel-webapp",
    "description": "Web Application for 3D Models Storing and Displaying",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Services\\": "backend/services/",
            "App\\Repositories\\": "backend/repositories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml",
        "test-coverage": "@php vendor/bin/phpunit --configuration phpunit.xml --coverage-clover coverage.xml"
    }
}
