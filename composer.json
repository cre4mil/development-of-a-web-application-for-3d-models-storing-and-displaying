{
    "name": "dev/3dmodel-webapp",
    "description": "Web Application for 3D Models Storing and Displaying",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "backend/controllers/",
            "App\\Http\\": "backend/http/",
            "App\\Repositories\\": "backend/repositories/",
            "App\\Services\\": "backend/services/",
            "App\\Support\\": "backend/support/"
        },
        "files": [
            "backend/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --no-coverage",
        "test-coverage": [
            "@php -d xdebug.mode=coverage vendor/bin/phpunit",
            "@php tools/relativize-clover.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
