# Copy to .env — real environment variables take precedence over this file.

# Database connection (local XAMPP defaults shown)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_3dmodels
DB_USER=root
DB_PASSWORD=

# Payment settings shown to buyers — replace before deploying.
# PAYMENT_METHOD: promptpay | truemoney | kbank | scb | bbl | ktb | krungsri
PAYMENT_METHOD=promptpay
PAYMENT_ACCOUNT=
PAYMENT_NAME=

# Optional: SlipOK API for automatic slip verification (empty = admins approve manually)
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# Optional: full path to blender.exe to auto-convert uploads to glTF / GLB / OBJ / USDZ
# Example (Windows): C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
BLENDER_PATH=

# Optional: override where uploaded files are stored (default: frontend/uploads)
UPLOAD_DIR=

# SonarQube (local server) — used by `docker compose --profile scanner up`
LOCAL_SONAR_TOKEN=
